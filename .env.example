# ===================================================================
# PayCore Backend — Environment Variables Configuration Template
# Copy this file to .env and customize values for your deployment.
# NEVER commit real production secrets or tokens to source control.
# ===================================================================

# Application Profile & Server Port
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3306/paycore_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=paycore_user
DB_PASSWORD=paycore_password

# Redis Distributed Cache & Lock Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka Event Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Authentication & Token Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000

# Google OAuth 2.0 & Gmail REST API Email Integration
# Register at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_REFRESH_TOKEN=1//04your_google_refresh_token_from_oauth_callback
GOOGLE_SENDER_EMAIL=omp27614@gmail.com
APP_FRONTEND_URL=http://localhost:5173

# Security Toggles (Keep false in production)
SEED_TEST_ADMIN=false
AUTO_VERIFY_EMAIL=false
