          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"omp27614@gmail.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/admin/initiate-setup", "host": ["{{baseUrl}}"], "path": ["auth", "admin", "initiate-setup"] }
