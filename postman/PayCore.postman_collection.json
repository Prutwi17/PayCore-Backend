        {
          "name": "Admin List All Merchants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/merchants?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["admin", "merchants"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] }
          }
        }
      ]
    }
  ]
}
